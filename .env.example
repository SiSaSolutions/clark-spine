# =============================================================================
# Clark Spine and Pain Relief — environment configuration
# Copy to `.env.local` for local development. NEVER commit real secrets.
# Values below are safe, non-functional placeholders.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# Canonical origin used for metadata, canonical URLs, sitemap, and hreflang.
# No trailing slash. Required in production; defaults to localhost otherwise.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cloudflare Turnstile (bot protection on the inquiry form) ----------------
# Public site key — safe to expose to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# Secret key — server-side verification only. NEVER expose to the client.
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# --- Resend (transactional email) ---------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
# Verified sending identity on your Resend domain.
INQUIRY_FROM_EMAIL="website@mg.example.com"
# Where new patient inquiries are delivered (server-controlled recipient).
INQUIRY_OWNER_EMAIL="frontdesk@example.com"
# In development/preview ALL mail is redirected here so real patients are never
# emailed. Leave unset in production.
DEV_EMAIL_OVERRIDE="you@example.com"

# --- Upstash Redis (serverless rate limiting) ---------------------------------
UPSTASH_REDIS_REST_URL="https://example.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXXXAAIjcDExxxxxxxxxxxxxxxxxxxxxx"

# Optional: salt used to hash client IPs before storing them in the rate-limit
# store (privacy). Set to any long random string per deployment.
RATE_LIMIT_SALT="change-me-to-a-long-random-string"
