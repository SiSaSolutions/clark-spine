{
  "name": "clark-spine-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "npm run check:i18n && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:i18n": "tsx scripts/check-translations.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "screenshots": "node scripts/visual-qa/cli.mjs",
    "screenshots:changed": "node scripts/visual-qa/cli.mjs --changed",
    "screenshots:all": "node scripts/visual-qa/cli.mjs --all",
    "screenshots:reset": "node scripts/visual-qa/cli.mjs --reset",
    "screenshots:dry": "node scripts/visual-qa/cli.mjs --dry-run",
    "screenshots:clean": "node scripts/screenshots-clean.mjs",
    "visual:qa": "npm run screenshots:all",
    "email:dev": "email dev --dir src/emails"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@react-email/components": "^1.0.12",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^10.1.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.54.0",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "react-email": "^4.3.2",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
